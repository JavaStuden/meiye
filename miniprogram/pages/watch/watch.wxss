.watch-page { min-height: 100vh; padding-bottom: 116rpx; background: #f4f5f7; }
.player { position: relative; height: 920rpx; overflow: hidden; background: #2e302f; color: #fff; }
.player-video { position: absolute; inset: 0; width: 100%; height: 100%; }
.player-cover { position: absolute; width: 100%; height: 100%; opacity: .86; }
.player-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.42), transparent 25%, rgba(0,0,0,.06) 47%, rgba(0,0,0,.65)); }
.player-head { position: absolute; top: 28rpx; left: 24rpx; right: 24rpx; display: flex; align-items: center; padding: 13rpx 15rpx; border-radius: 60rpx; background: rgba(30,31,30,.56); }
.channel-avatar { display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border-radius: 50%; background: #fff; color: #d65450; font-size: 36rpx; font-weight: 800; }
.channel-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: 14rpx; }
.channel-title { overflow: hidden; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.channel-meta { margin-top: 6rpx; color: rgba(255,255,255,.8); font-size: 19rpx; }
.more-button { width: 76rpx; height: 56rpx; border-radius: 30rpx; background: rgba(255,255,255,.82); color: #303030; font-size: 34rpx; line-height: 46rpx; }
.player-label { position: absolute; top: 142rpx; left: 28rpx; display: flex; align-items: center; gap: 10rpx; padding: 10rpx 14rpx; border-radius: 8rpx; background: rgba(38,42,42,.62); font-size: 22rpx; }
.live-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #ed756d; }
.play-button { position: absolute; top: 46%; left: 50%; display: flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; transform: translate(-50%,-50%); border: 2rpx solid rgba(255,255,255,.82); border-radius: 50%; background: rgba(0,0,0,.22); font-size: 34rpx; }
.player-caption { position: absolute; top: calc(46% + 64rpx); width: 100%; color: #fff; text-align: center; font-size: 20rpx; text-shadow: 0 1rpx 6rpx #000; }
.room-intro { position: absolute; right: 28rpx; bottom: 34rpx; left: 28rpx; display: flex; flex-direction: column; gap: 10rpx; }
.intro-title { font-size: 31rpx; font-weight: 750; }
.intro-meta { color: rgba(255,255,255,.82); font-size: 21rpx; }
.notice { display: flex; align-items: flex-start; gap: 14rpx; margin: 18rpx 22rpx 0; padding: 18rpx; border-radius: 12rpx; background: #fff; }
.notice-badge { flex-shrink: 0; padding: 5rpx 9rpx; border-radius: 6rpx; background: #fff0e6; color: #be6843; font-size: 20rpx; }
.notice-text { color: #606773; font-size: 23rpx; line-height: 1.55; }
.interaction-area { margin: 22rpx 28rpx; }
.topic-row { display: flex; align-items: center; gap: 12rpx; color: #58606a; font-size: 22rpx; }
.topic-pill { padding: 6rpx 12rpx; border-radius: 7rpx; background: #e7e8eb; color: #555b65; }
.comments { display: flex; flex-direction: column; gap: 17rpx; margin-top: 25rpx; }
.comment-row { color: #343841; font-size: 23rpx; line-height: 1.4; }
.comment-name { font-weight: 700; }
.comment-name.violet { color: #8158be; }
.comment-name.blue { color: #4d7ca4; }
.comment-name.green { color: #54886b; }
.action-bar { position: fixed; z-index: 3; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-around; height: 112rpx; padding: 0 14rpx calc(env(safe-area-inset-bottom) / 2); background: #fff; box-shadow: 0 -4rpx 18rpx rgba(24,32,40,.06); }
.comment-trigger { width: 185rpx; height: 66rpx; padding-left: 22rpx; border-radius: 40rpx; background: #f1f2f4; color: #727984; text-align: left; font-size: 23rpx; line-height: 66rpx; }
.action-icon { display: flex; min-width: 58rpx; flex-direction: column; align-items: center; color: #6b727d; font-size: 24rpx; line-height: 1.2; }
.action-icon::first-line { font-size: 30rpx; }
.action-icon text { margin-top: 6rpx; color: #9298a1; font-size: 18rpx; }
.product-action { color: #e8793f; }
.like-action { color: #68717b; }
.like-action.is-liked { color: #e75b5f; }
.sheet-mask,.comment-mask { position: fixed; z-index: 8; inset: 0; background: rgba(15,20,25,.5); }
.product-sheet { position: fixed; z-index: 9; right: 0; bottom: 0; left: 0; padding: 18rpx 24rpx calc(26rpx + env(safe-area-inset-bottom)); border-radius: 22rpx 22rpx 0 0; background: #fff; }
.sheet-handle { width: 70rpx; height: 7rpx; margin: 0 auto 20rpx; border-radius: 9rpx; background: #d9dce1; }
.sheet-title { display: flex; justify-content: space-between; font-size: 31rpx; font-weight: 700; }
.sheet-close { color: #8d939c; font-size: 23rpx; font-weight: 400; }
.sheet-demo { margin: 16rpx 0; color: #9a6a42; font-size: 21rpx; }
.product-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-top: 1rpx solid #eff0f2; }
.product-image { width: 108rpx; height: 108rpx; border-radius: 10rpx; background: #f1f1ef; }
.product-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 13rpx; }
.product-name { overflow: hidden; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.product-price { color: #dc604a; font-size: 24rpx; font-weight: 700; }
.old-price { margin-left: 8rpx; color: #9a9fa7; font-size: 19rpx; font-weight: 400; text-decoration: line-through; }
.buy-button { padding: 10rpx 20rpx; border-radius: 30rpx; background: #fff0e9; color: #d76045; font-size: 22rpx; }
.comment-sheet { position: fixed; z-index: 9; right: 0; bottom: 0; left: 0; display: flex; gap: 14rpx; padding: 22rpx 20rpx calc(22rpx + env(safe-area-inset-bottom)); background: #fff; }
.comment-input { flex: 1; height: 74rpx; padding: 0 22rpx; border-radius: 38rpx; background: #f0f1f3; font-size: 24rpx; }
.send-button { width: 112rpx; height: 74rpx; border-radius: 38rpx; background: #e86d50; color: #fff; font-size: 23rpx; line-height: 74rpx; }
