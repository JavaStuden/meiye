<view class="store-page">
  <view class="store-search"><input placeholder="搜索直播间商品" value="{{query}}" bindinput="onSearchInput" confirm-type="search" bindconfirm="search"/><button bindtap="search">搜索</button></view>
  <view class="store-banner"><image src="/assets/beauty-products.jpg" mode="aspectFill"/><view class="banner-copy"><text class="banner-tag">直播间专享</text><text class="banner-title">秋季美肤节</text><text class="banner-sub">直播好物 · 新人福利</text></view></view>
  <view class="shortcut-card"><view class="shortcut-grid"><view wx:for="{{shortcuts}}" wx:key="view" class="shortcut" data-view="{{item.view}}" bindtap="openFeature"><view class="shortcut-icon color-{{index % 5}}">{{item.icon}}</view><text>{{item.label}}</text></view></view></view>
  <view class="headline" data-view="news" bindtap="openFeature"><text class="headline-tag">商城头条</text><text>秋季美肤专场已上线，直播间领取新人专属福利</text><text class="arrow">›</text></view>
  <view class="coupon-section"><view class="section-heading"><text>新人福利</text><text class="section-link" data-view="coupon" bindtap="openFeature">进入领券中心 ›</text></view><view class="coupon-row"><view class="coupon" wx:for="{{coupons}}" wx:key="id"><view><text class="coupon-amount">¥{{item.amount}}</text><text class="coupon-label">优惠券<br/>满{{item.threshold}}元可用</text></view><button data-id="{{item.id}}" data-name="{{item.name}}" data-amount="{{item.amount}}" data-threshold="{{item.threshold}}" bindtap="takeCoupon">立即<br/>领取</button></view></view></view>
  <view class="section-heading live-heading"><text>美业直播</text><text class="section-link" data-tab="home" bindtap="openTab">全部直播 ›</text></view>
  <view class="mini-room" wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="openRoom"><image src="{{item.cover}}" mode="aspectFill"/><view class="mini-room-copy"><text class="room-name">{{item.title}}</text><text class="room-meta">{{item.mode}} · {{item.time}}</text><text class="room-meta">老师讲解 / 美业专场</text></view><text class="room-state">{{item.status}}</text></view>
  <view class="section-heading product-heading"><text>直播精选好物</text><text class="section-link" data-tab="category" bindtap="openTab">全部商品 ›</text></view>
  <view class="product-grid"><view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct"><image src="{{item.cover}}" mode="aspectFill"/><text class="product-name">{{item.name}}</text><view><text class="product-price">¥{{item.price}}</text><text class="old-price">¥{{item.original}}</text></view><text class="product-tag">{{item.tag}}</text></view></view>
</view>
