.mine-page { padding-bottom: 36rpx; }
.profile-card { position: relative; padding: 30rpx 28rpx 26rpx; color: #fff; background: linear-gradient(125deg, #ff4769, #f04b95); }
.profile-card { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; }.profile-avatar { display: grid; width: 94rpx; height: 94rpx; place-items: center; border: 2rpx solid #ffffff80; border-radius: 50%; color: #fff; background: #ffffff33; font-size: 47rpx; }.profile-copy { display: flex; flex-direction: column; gap: 9rpx; }.profile-title { font-size: 31rpx; font-weight: 700; }.profile-subtitle { color: #ffe9f0; font-size: 20rpx; }.profile-arrow { margin-left: auto; font-size: 35rpx; }.profile-stats { display: flex; width: 100%; justify-content: space-around; margin-top: 28rpx; text-align: center; }.profile-stats view { display: flex; flex-direction: column; gap: 5rpx; }.profile-stats text { font-size: 30rpx; font-weight: 700; }.profile-stats label { color: #ffe9f0; font-size: 19rpx; }
.demo-note { display: flex; align-items: center; gap: 12rpx; margin: 16rpx 24rpx; padding: 16rpx; border-radius: 9rpx; color: #a66935; background: #fff3e3; font-size: 20rpx; }.note-mark { display: grid; width: 28rpx; height: 28rpx; place-items: center; border-radius: 50%; color: #fff; background: #f0b067; font-weight: 700; }
.mine-section { overflow: hidden; margin: 0 24rpx 18rpx; border-radius: 12rpx; background: #fff; }.section-heading { display: flex; justify-content: space-between; padding: 22rpx 20rpx 15rpx; color: #2d2933; font-size: 28rpx; font-weight: 700; }.section-link { color: #aaa4ad; font-size: 20rpx; font-weight: 400; }
.order-icons { display: flex; justify-content: space-around; padding: 10rpx 10rpx 24rpx; }.order-action { display: flex; flex-direction: column; align-items: center; gap: 9rpx; color: #77717d; font-size: 19rpx; }.order-icon { display: grid; width: 51rpx; height: 51rpx; place-items: center; border: 1rpx solid #e6e2e8; border-radius: 10rpx; color: #8b748d; font-size: 20rpx; }
.menu-row { display: flex; align-items: center; gap: 14rpx; margin: 0 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #f0edf1; color: #3c3741; font-size: 24rpx; }.menu-row:last-child { border-bottom: 0; }.menu-icon { display: grid; width: 48rpx; height: 48rpx; place-items: center; border-radius: 10rpx; color: #f0785c; background: #fff0e9; font-size: 21rpx; }.menu-label { flex: 1; }.menu-arrow { color: #aaa4ad; font-size: 31rpx; }.version { padding: 18rpx 0; color: #aaa4ad; text-align: center; font-size: 19rpx; }
