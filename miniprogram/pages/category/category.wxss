.category-page { height: 100%; background: #fff; }
.category-layout { display: flex; height: calc(100vh - 100rpx); }
.category-menu { flex: none; width: 174rpx; background: #f4f3f6; }
.category-item { padding: 29rpx 9rpx; border-left: 6rpx solid transparent; color: #4f4a55; text-align: center; font-size: 22rpx; }
.category-item.active { border-color: #f3447b; color: #f3447b; background: #fff; }
.category-content { flex: 1; min-width: 0; padding: 16rpx; box-sizing: border-box; }
.category-banner { position: relative; height: 220rpx; overflow: hidden; border-radius: 9rpx; background: #f5d8d5; }
.category-banner image { width: 100%; height: 100%; }
.category-banner text { position: absolute; left: 18rpx; top: 31rpx; width: 200rpx; color: #88314d; font-size: 31rpx; font-weight: 800; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 12rpx; margin-top: 16rpx; }
.product-card { display: flex; min-width: 0; flex-direction: column; gap: 7rpx; }
.product-card image { width: 100%; height: 210rpx; border-radius: 7rpx; background: #f5e2df; }
.product-name { min-height: 54rpx; color: #38333c; font-size: 20rpx; line-height: 1.4; }
.product-tag { align-self: flex-start; padding: 3rpx 7rpx; color: #e55b83; background: #fff0f4; font-size: 16rpx; }
.price-row { display: flex; align-items: baseline; gap: 8rpx; }.price { color: #f3447b; font-size: 24rpx; }.old-price { color: #aaa4ad; font-size: 17rpx; text-decoration: line-through; }.sold { color: #aaa4ad; font-size: 17rpx; text-align: right; }
.empty { padding: 80rpx 0; color: #aaa; text-align: center; }
