.feature-page { min-height: 100vh; padding: 18rpx 22rpx 40rpx; box-sizing: border-box; background: #f4f3f6; }
.detail-image { display: block; width: 100%; height: 600rpx; border-radius: 12rpx 12rpx 0 0; background: #f2dfdd; }.detail-card,.feature-card { display: flex; flex-direction: column; gap: 15rpx; margin-bottom: 16rpx; padding: 22rpx; border-radius: 12rpx; background: #fff; color: #39353f; font-size: 23rpx; }.detail-card { margin-top: 0; }.detail-price { display: flex; align-items: baseline; gap: 10rpx; }.detail-price > text:first-child,.bargain-price { color: #f3447b; font-size: 42rpx; font-weight: 700; }.sold { margin-left: auto; color: #aaa4ad; font-size: 19rpx; }.detail-name,.card-title { color: #302c36; font-size: 28rpx; font-weight: 700; }.detail-meta,.muted { color: #96909b; font-size: 20rpx; }.detail-row,.summary-row { display: flex; align-items: center; justify-content: space-between; padding: 15rpx 0; border-top: 1rpx solid #f0edf1; }.quantity { display: flex; align-items: center; gap: 18rpx; }.quantity button { width: 46rpx; height: 44rpx; margin: 0; padding: 0; border: 1rpx solid #ede9ef; border-radius: 6rpx; font-size: 25rpx; line-height: 42rpx; }.quantity button::after { border: 0; }.detail-tip,.demo-hint { color: #96909b; font-size: 19rpx; line-height: 1.55; }.buy-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 10rpx; padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eeeaf0; background: #fff; }.buy-bar button,.pink-button,.primary-button { margin: 0; border-radius: 40rpx; color: #fff; background: #f3447b; font-size: 21rpx; }.buy-bar button::after,.pink-button::after,.primary-button::after { border: 0; }.icon-buy { padding: 12rpx 18rpx; color: #6d6671 !important; background: #f5f2f6 !important; }.cart-buy,.primary-buy { flex: 1; padding: 13rpx 0; }.cart-buy { background: #ff8e65 !important; }.primary-buy { background: #f3447b !important; }
.filter-scroll { white-space: nowrap; margin: 0 -22rpx 18rpx; padding: 0 22rpx 3rpx; }.filter-row { display: inline-flex; gap: 12rpx; }.filter-chip { padding: 12rpx 20rpx; border-radius: 30rpx; color: #605b65; background: #fff; font-size: 20rpx; }.filter-chip.active { color: #f3447b; background: #ffebf1; }.order-card { gap: 12rpx; }.order-head { display: flex; justify-content: space-between; padding-bottom: 12rpx; border-bottom: 1rpx solid #f0edf1; font-weight: 600; }.order-status { color: #f0785c; }.checkout-product { display: flex; align-items: center; gap: 15rpx; }.checkout-product image { flex: none; width: 120rpx; height: 120rpx; border-radius: 8rpx; background: #f3e4e1; }.checkout-product view { display: flex; flex-direction: column; gap: 9rpx; }.price { color: #f3447b; font-size: 24rpx; font-weight: 600; }.order-id { color: #aaa4ad; font-size: 18rpx; }.pickup-code { padding: 20rpx; border-radius: 8rpx; text-align: center; background: #f7f8fa; }.pickup-code text { font-weight: 700; }.order-actions { display: flex; justify-content: flex-end; gap: 10rpx; }.order-actions button { margin: 0; padding: 7rpx 15rpx; border: 1rpx solid #e9e5eb; border-radius: 7rpx; font-size: 19rpx; }.order-actions button::after { border: 0; }.empty { padding: 70rpx 15rpx; color: #aaa4ad; text-align: center; }
.promo-hero { display: flex; flex-direction: column; gap: 12rpx; margin: -18rpx -22rpx 17rpx; padding: 38rpx 24rpx; color: #fff; background: linear-gradient(120deg,#ff4769,#f05b9c); font-size: 22rpx; }.promo-hero > text:first-child { font-size: 34rpx; font-weight: 700; }.promo-hero.center { align-items: center; text-align: center; }.big-number { font-size: 54rpx; font-weight: 700; }.reward-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }.reward-tile { display: flex; min-height: 105rpx; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; border: 1rpx solid #f1dec8; border-radius: 9rpx; color: #665443; background: #fff6ec; font-size: 19rpx; text-align: center; }.reward-tile text { color: #998b7c; font-size: 17rpx; }.pink-button { align-self: flex-start; padding: 12rpx 24rpx; }.pink-button.full,.primary-button { width: 100%; align-self: stretch; padding: 14rpx; }.list-link { display: flex; justify-content: space-between; width: 100%; padding: 17rpx 0; border-bottom: 1rpx solid #f0edf1; background: transparent; text-align: left; font-size: 22rpx; }.list-link::after { border: 0; }.list-link text { color: #aaa4ad; font-size: 19rpx; }.wheel-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 9rpx; }.wheel-tile { display: grid; min-height: 112rpx; place-items: center; border: 1rpx solid #f0dfca; border-radius: 9rpx; color: #695944; background: #fff6ec; text-align: center; font-size: 19rpx; }.wheel-tile.center-tile { border-radius: 20rpx; color: #fff; background: #f3447b; font-weight: 700; }.coupon-offer { display: flex; justify-content: space-between; align-items: center; padding: 18rpx; border-radius: 9rpx; color: #db4774; background: #fff0f4; }.coupon-offer view { display: flex; align-items: center; gap: 12rpx; font-size: 19rpx; }.coupon-amount { font-size: 40rpx; font-weight: 700; }.coupon-offer button { margin: 0; padding: 8rpx 12rpx; border-radius: 6rpx; color: #fff; background: #f3447b; font-size: 18rpx; }.coupon-offer button::after { border: 0; }
.campaign-row { display: flex; flex-direction: row; align-items: center; gap: 14rpx; }.campaign-row image { flex: none; width: 140rpx; height: 140rpx; border-radius: 8rpx; background: #f3e4e1; }.campaign-row > view { display: flex; flex-direction: column; gap: 10rpx; }.progress { height: 15rpx; overflow: hidden; border-radius: 12rpx; background: #e9edf5; }.progress view { width: 38%; height: 100%; border-radius: inherit; background: #f7a3bb; }.bargain-image { width: 180rpx; height: 180rpx; border-radius: 8rpx; }.stats-row { display: flex; width: 100%; justify-content: space-around; margin-top: 14rpx; text-align: center; }.stats-row view { display: flex; flex-direction: column; gap: 5rpx; }.stats-row view > text { font-size: 31rpx; font-weight: 700; }.stats-row label { color: #ffe8ef; font-size: 18rpx; }.rank-row,.relation-row { display: flex; align-items: center; gap: 15rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0edf1; }.rank-index { display: grid; width: 39rpx; height: 39rpx; place-items: center; border-radius: 50%; color: #a77839; background: #fff2da; }.rank-row .muted,.relation-row text:last-child { margin-left: auto; }.map-placeholder { display: grid; height: 230rpx; place-items: center; border-radius: 9rpx; color: #9a96a0; background: repeating-linear-gradient(45deg,#f2f1f3,#f2f1f3 18rpx,#edebef 18rpx,#edebef 36rpx); }.news-tag { align-self: flex-start; padding: 6rpx 12rpx; color: #e55b83; background: #fff0f4; font-size: 19rpx; }.news-title { font-size: 31rpx; font-weight: 700; }.news-copy { margin: 16rpx 0; line-height: 1.7; }.feature-disclaimer { padding: 16rpx; color: #a8a2ad; text-align: center; font-size: 18rpx; }
