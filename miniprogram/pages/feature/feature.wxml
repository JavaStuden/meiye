<view class="feature-page" wx:if="{{state}}">
  <block wx:if="{{view === 'detail'}}">
    <image class="detail-image" src="{{product.cover}}" mode="aspectFill"/><view class="detail-card"><view class="detail-price"><text>¥{{product.price}}</text><text class="old-price">¥{{product.original}}</text><text class="sold">已售 {{product.sold}}</text></view><text class="detail-name">{{product.name}}</text><text class="detail-meta">{{product.tag}} · {{product.category}}</text><view class="detail-row"><text>数量</text><view class="quantity"><button data-delta="-1" bindtap="changeQuantity">−</button><text>{{quantity}}</text><button data-delta="1" bindtap="changeQuantity">＋</button></view></view><view class="detail-tip">商品、支付及履约为本地交互演示，不会真实扣款或发货。</view></view><view class="buy-bar"><button class="icon-buy" bindtap="toggleFavorite">{{isFavorite ? '已收藏' : '收藏'}}</button><button class="cart-buy" bindtap="addToCart">加入购物车</button><button class="primary-buy" bindtap="buyNow">立即购买</button></view>
  </block>
  <block wx:elif="{{view === 'checkout'}}">
    <view class="feature-card"><text class="card-title">确认订单</text><view wx:for="{{cartItems}}" wx:key="productId" class="checkout-product"><image src="{{item.product.cover}}" mode="aspectFill"/><view><text>{{item.product.name}}</text><text class="price">¥{{item.product.price}} × {{item.quantity}}</text></view></view><view class="summary-row"><text>配送方式</text><text>快递配送（演示）</text></view><view class="summary-row"><text>优惠券</text><text>{{state.coupons.length ? '可用优惠券' : '暂无可用优惠券'}}</text></view><view class="summary-row"><text>合计</text><text class="price">订单金额按购物车计算</text></view><text class="demo-hint">订单只保存在本机演示数据中，不会请求真实支付或发货。</text><button class="primary-button" bindtap="checkout">提交演示订单</button></view>
  </block>
  <block wx:elif="{{view === 'orders'}}">
    <scroll-view class="filter-scroll" scroll-x><view class="filter-row"><view wx:for="{{filters}}" wx:key="*this" class="filter-chip {{activeFilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="setFilter">{{item}}</view></view></scroll-view>
    <view wx:for="{{visibleOrders}}" wx:key="id" class="feature-card order-card"><view class="order-head"><text>悦己美学</text><text class="order-status">{{item.status}}</text></view><view class="checkout-product"><image src="{{item.product.cover}}" mode="aspectFill"/><view><text>{{item.product.name}}</text><text class="muted">数量 {{item.quantity}}</text><text class="price">¥{{item.totalText}}</text></view></view><text class="order-id">{{item.id}}</text><view wx:if="{{item.code}}" class="pickup-code" data-code="{{item.code}}" bindtap="copyCode">取货/核销码 <text>{{item.code}}</text></view><view class="order-actions"><button wx:if="{{item.status === '待付款'}}" data-id="{{item.id}}" bindtap="cancelOrder">取消订单</button><button wx:if="{{item.status === '待收货' || item.status === '待核销'}}" data-id="{{item.id}}" bindtap="confirmReceive">{{item.status === '待核销' ? '确认核销' : '确认收货'}}</button><button data-id="{{item.id}}" bindtap="noop">订单详情</button></view></view>
    <view wx:if="{{visibleOrders.length === 0}}" class="empty">暂无订单</view>
  </block>
  <block wx:elif="{{view === 'course'}}"><view class="promo-hero"><text>美业精品回放</text><text>仅展示已发布的录像，素材库中的草稿不会公开</text></view><view wx:for="{{courseRooms}}" wx:key="id" class="feature-card"><text class="card-title">{{item.title}}</text><text class="muted">全部会员 · 28:05</text><button class="pink-button" data-id="{{item.id}}" bindtap="openRoom">观看录播</button></view><view wx:if="{{!courseRooms.length}}" class="empty">暂无已发布回放</view></block>
  <block wx:elif="{{view === 'coupon'}}"><view class="feature-card"><text class="card-title">直播间优惠券</text><view wx:for="{{couponOffers}}" wx:key="id" class="coupon-offer"><view><text class="coupon-amount">¥{{item.amount}}</text><text>{{item.name}} · 满{{item.threshold}}元可用</text></view><button data-id="{{item.id}}" data-name="{{item.name}}" data-amount="{{item.amount}}" data-threshold="{{item.threshold}}" bindtap="takeCoupon">{{item.claimed ? '已领取' : '立即领取'}}</button></view><text class="muted">优惠券满额后可在演示订单选择使用。</text></view></block>
  <block wx:elif="{{view === 'points'}}"><view class="promo-hero center"><text>我的积分</text><text class="big-number">{{state.points}}</text><text>看直播、签到、参与活动积累积分</text></view><view class="feature-card"><text class="card-title">每日签到</text><view class="reward-grid"><view wx:for="{{weekPoints}}" wx:key="*this" class="reward-tile">第{{index + 1}}天<text>+{{item}}分</text></view></view><button class="pink-button full" bindtap="checkIn">{{state.signed ? '今天已签到' : '签到领积分'}}</button></view><view class="feature-card"><button class="list-link" data-view="lottery" bindtap="openFeature">积分抽奖 <text>去参与 ›</text></button></view></block>
  <block wx:elif="{{view === 'lottery'}}"><view class="promo-hero"><text>直播幸运转盘</text><text>20积分参与一次 / 当前积分 {{state.points}}</text></view><view class="feature-card"><view class="wheel-grid"><view wx:for="{{prizeTiles}}" wx:key="*this" class="wheel-tile {{index === wheelIndex ? 'center-tile' : ''}}">{{item}}</view></view><text class="demo-hint">{{state.lastPrize || '抽奖结果为演示，奖品由后台配置。'}}</text><button class="pink-button full" bindtap="drawPrize">参与抽奖</button></view></block>
  <block wx:elif="{{view === 'flash'}}"><view class="promo-hero"><text>限时秒杀</text><text>秋季修护专场 · 活动时间以页面展示为准</text></view><view wx:for="{{campaignProducts}}" wx:key="id" class="feature-card campaign-row"><image src="{{item.cover}}" mode="aspectFill"/><view><text>{{item.name}}</text><text class="price">¥{{item.promoPrice}}</text><text class="muted">剩余 {{item.stock}} 件 · 演示库存</text></view></view></block>
  <block wx:elif="{{view === 'group'}}"><view class="promo-hero"><text>2人拼团 · 直播好物</text><text>邀请好友一起享优惠</text></view><view class="feature-card"><view class="campaign-row"><image src="/assets/beauty-products.jpg" mode="aspectFill"/><view><text>舒缓修护精华液 30ml</text><text class="price">¥129.00</text><text class="muted">原价 ¥159.00</text></view></view><view class="progress"><view></view></view><button class="pink-button" bindtap="startGroup">发起拼团</button><text class="demo-hint">团进度与优惠下单为本地模拟。</text></view></block>
  <block wx:elif="{{view === 'bargain'}}"><view class="promo-hero"><text>好友助力 · 享优惠</text><text>当前活动底价 ¥99.00</text></view><view class="feature-card"><image class="bargain-image" src="/assets/beauty-products.jpg" mode="aspectFill"/><text class="card-title">舒缓修护精华液 30ml</text><text>已邀请 {{state.bargainHelp || 0}} 位演示好友助力</text><text class="bargain-price">¥{{bargainText}}</text><button class="pink-button full" open-type="share">邀请好友助力</button><text class="demo-hint">分享操作需使用右上角菜单；助力数量为演示状态。</text></view></block>
  <block wx:elif="{{view === 'recharge'}}"><view class="promo-hero center"><text>我的余额</text><text class="big-number">¥{{state.walletText}}</text></view><view class="feature-card"><text class="card-title">会员充值有礼</text><view class="reward-grid"><button wx:for="{{rechargeOptions}}" wx:key="amount" class="reward-tile" data-amount="{{item.amount}}" bindtap="confirmRecharge">¥{{item.amount}}<text>赠送¥{{item.gift}}</text></button></view><text class="demo-hint">选择金额仅在本地增加演示余额，不调用真实支付。</text></view></block>
  <block wx:elif="{{view === 'distribution'}}"><view class="promo-hero center"><text>我的推广中心</text><text>推广员编号 MY1008</text><view class="stats-row"><view><text>12</text><label>已邀请用户</label></view><view><text>¥{{state.commissionText}}</text><label>可提现佣金</label></view></view></view><view class="feature-card"><button class="list-link" open-type="share">分享直播 / 商品 <text>生成分享卡片 ›</text></button><button class="list-link" data-view="rank" bindtap="openFeature">直播邀请榜 <text>查看排名 ›</text></button><button class="list-link" data-view="withdraw" bindtap="openFeature">佣金提现 <text>申请 ›</text></button></view><view class="feature-card"><text class="card-title">我的推广关系</text><text wx:for="{{invitees}}" wx:key="*this" class="relation-row">{{item}}<text>1笔关联订单</text></text><text class="demo-hint">分销归因与佣金结算为演示数据。</text></view></block>
  <block wx:elif="{{view === 'rank'}}"><view class="promo-hero"><text>直播邀请榜</text><text>邀请好友一起学习</text></view><view class="feature-card"><view wx:for="{{rankings}}" wx:key="*this" class="rank-row"><text class="rank-index">{{index + 1}}</text><text>{{item}}</text><text class="muted">{{12 - index * 2}}位好友</text></view></view></block>
  <block wx:elif="{{view === 'withdraw'}}"><view class="feature-card"><text class="card-title">可提现佣金</text><text class="bargain-price">¥{{state.commissionText}}</text><text class="demo-hint">正式提现需要接入合规资金服务；本演示不收集银行卡或收款码。</text><button class="pink-button full" bindtap="requestWithdraw">提交演示申请</button></view></block>
  <block wx:elif="{{view === 'stores'}}"><view class="feature-card"><text class="card-title">悦己美学 · 总部旗舰店</text><text>演示地址：品牌体验中心一层</text><text class="muted">10:00—21:00 / 营业中</text><view class="map-placeholder">門店位置示意</view><button class="pink-button" bindtap="contactStore">联系门店</button></view></block>
  <block wx:elif="{{view === 'messages'}}"><view class="feature-card"><text class="card-title">消息通知</text><view class="empty">暂无新通知。后台发送的演示通知会显示在这里。</view></view></block>
  <block wx:elif="{{view === 'favorites'}}"><view wx:for="{{favoriteProducts}}" wx:key="id" class="feature-card campaign-row"><image src="{{item.cover}}" mode="aspectFill"/><view><text>{{item.name}}</text><text class="price">¥{{item.price}}</text></view></view><view wx:if="{{!favoriteProducts.length}}" class="empty">暂无收藏</view></block>
  <block wx:elif="{{view === 'news'}}"><view class="feature-card"><text class="news-tag">商城头条</text><text class="news-title">秋季美肤专场已上线，直播间领取新人专属福利</text><text class="muted">品牌运营 · 美业直播</text><text class="news-copy">新一期美业直播与录播课程已上线，可在直播中心查看开播预告、课程回放与直播间商品。</text><button class="pink-button" bindtap="goStore">进入商城</button></view></block>
  <block wx:elif="{{view === 'address'}}"><view class="feature-card"><text class="card-title">收货地址</text><text>{{state.addresses[0].name}} {{state.addresses[0].phone}}</text><text>{{state.addresses[0].address}}</text><text class="demo-hint">演示地址，不作为真实配送信息。</text></view></block>
  <view class="feature-disclaimer">交互演示版本 · 不接入真实支付、资金结算、门店定位或直播推流</view>
</view>
