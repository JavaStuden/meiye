.live-page { padding-bottom: 24rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 28rpx 18rpx; }
.section-head > view { display: flex; flex-direction: column; gap: 7rpx; }
.section-title { font-size: 34rpx; font-weight: 700; }
.section-subtitle { color: #96919b; font-size: 22rpx; }
.plain-link { padding: 0 8rpx; color: #f3447b; font-size: 23rpx; background: transparent; }
.plain-link::after { border: 0; }
.filter-scroll { white-space: nowrap; padding: 0 24rpx 20rpx; }
.filter-row { display: inline-flex; gap: 14rpx; }
.filter-chip { padding: 13rpx 24rpx; border-radius: 28rpx; color: #5d5863; background: #f3f0f4; font-size: 23rpx; }
.filter-chip.active { color: #f3447b; background: #ffebf1; }
.room-list { padding: 0 22rpx; }
.room-card { overflow: hidden; margin: 0 0 20rpx; border-radius: 14rpx; background: #fff; box-shadow: 0 3rpx 16rpx rgba(39, 34, 48, .04); }
.room-cover-wrap { position: relative; height: 350rpx; background: #e8d9d4; }
.room-cover { width: 100%; height: 100%; }
.cover-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(22, 18, 24, .06), transparent 45%, rgba(22, 18, 24, .35)); }
.room-status { position: absolute; left: 20rpx; top: 20rpx; display: flex; align-items: center; gap: 9rpx; padding: 8rpx 13rpx; border-radius: 8rpx; color: #fff; background: rgba(34, 31, 39, .72); font-size: 21rpx; }
.room-status.live { background: #f3447b; }
.room-status.upcoming { color: #a66b22; background: #fff4e3; }
.room-status.ended { background: rgba(73, 70, 78, .68); }
.status-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #ffcf69; }
.room-status.live .status-dot { background: #fff; }
.cover-play { position: absolute; left: 50%; top: 50%; display: flex; width: 78rpx; height: 78rpx; align-items: center; justify-content: center; transform: translate(-50%, -50%); border: 2rpx solid rgba(255,255,255,.85); border-radius: 50%; color: #fff; background: rgba(23, 29, 32, .3); font-size: 26rpx; }
.room-info { padding: 20rpx 22rpx 18rpx; }
.room-title { display: block; color: #292631; font-size: 28rpx; font-weight: 700; }
.room-meta { display: flex; justify-content: space-between; margin-top: 12rpx; color: #aaa5af; font-size: 21rpx; }
.room-footer { display: flex; align-items: center; justify-content: space-between; margin-top: 17rpx; }
.room-host { color: #88838d; font-size: 22rpx; }
.room-button { margin: 0; padding: 8rpx 22rpx; border-radius: 30rpx; color: #fff; background: #f3447b; font-size: 22rpx; line-height: 1.6; }
.room-button::after { border: 0; }
.empty-state { padding: 100rpx 20rpx; color: #a6a1aa; text-align: center; }
.footer-note { padding: 18rpx 0 32rpx; color: #a6a1aa; text-align: center; font-size: 20rpx; }
