.cart-page { min-height: 100vh; padding: 20rpx 22rpx 140rpx; box-sizing: border-box; background: #f4f3f6; }
.cart-list { overflow: hidden; padding: 0 18rpx; border-radius: 12rpx; background: #fff; }
.cart-row { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0edf1; }
.cart-row:last-child { border-bottom: 0; }
.check { display: grid; flex: none; width: 36rpx; height: 36rpx; place-items: center; border: 2rpx solid #c9c5cc; border-radius: 50%; color: #fff; font-size: 22rpx; }.check.checked { border-color: #f3447b; background: #f3447b; }
.cart-row image { flex: none; width: 132rpx; height: 132rpx; border-radius: 8rpx; background: #f3e4e1; }
.cart-info { display: flex; flex: 1; flex-direction: column; gap: 10rpx; min-width: 0; }.cart-name { color: #302d35; font-size: 23rpx; }.price { color: #f3447b; font-size: 24rpx; font-weight: 600; }
.quantity { display: flex; align-items: center; gap: 14rpx; color: #66616b; font-size: 21rpx; }.quantity button { display: grid; width: 42rpx; height: 42rpx; place-items: center; margin: 0; padding: 0; border: 1rpx solid #eeeaf0; border-radius: 5rpx; font-size: 25rpx; line-height: 1; }.quantity button::after { border: 0; }.remove { margin-left: auto; color: #aaa4ad; font-size: 19rpx; }
.empty-cart { display: flex; flex-direction: column; align-items: center; padding-top: 210rpx; color: #a49eaa; font-size: 23rpx; }.empty-icon { display: grid; width: 110rpx; height: 110rpx; place-items: center; margin-bottom: 20rpx; border-radius: 50%; color: #c9c3ce; background: #ebe8ee; font-size: 48rpx; }.empty-cart button { margin-top: 28rpx; padding: 11rpx 32rpx; border-radius: 36rpx; color: #fff; background: #f3447b; font-size: 22rpx; }.empty-cart button::after { border: 0; }
.checkout-bar { position: fixed; left: 0; right: 0; bottom: 100rpx; display: flex; align-items: center; padding: 20rpx 28rpx; border-top: 1rpx solid #eeeaf0; background: #fff; font-size: 22rpx; }.total { color: #f3447b; font-size: 31rpx; font-weight: 700; }.checkout-bar button { margin: 0 0 0 auto; padding: 12rpx 42rpx; border-radius: 40rpx; color: #fff; background: #f3447b; font-size: 22rpx; }.checkout-bar button::after { border: 0; }
